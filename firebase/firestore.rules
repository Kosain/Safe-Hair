rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /scalp_analyses/{docId} {
      allow read, write: if request.auth != null;
    }
    match /appointments/{docId} {
      allow read, write: if request.auth != null;
    }
    // Doctor-created alerts for patients (accept/decline). Patient may read/update own rows.
    match /patient_notifications/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /patient_details/{docId} {
      // Patient profile: doc id should equal Auth uid; legacy docs may use random id + userId field.
      allow read: if request.auth != null
          && (request.auth.uid == docId
              || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null
          && (request.auth.uid == docId
              || request.resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null && request.auth.uid == docId;

      match /hair_scans/{scanId} {
        allow read, write: if request.auth != null
            && request.auth.uid == docId;
      }
      match /reports/{reportId} {
        allow read, write: if request.auth != null
            && request.auth.uid == docId;
      }
    }
    match /doctors/{docId} {
      allow read, write: if request.auth != null;
    }
    match /doctor_reviews/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5;
      allow update, delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
    }
    match /reports/{docId} {
      allow read, write: if request.auth != null;
    }
    match /guidelines/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
