# Copy to ".env" in this folder (backend/.env). Do not commit .env.

# Full path to your Firebase service account JSON (Project settings > Service accounts).
# FIREBASE_SERVICE_ACCOUNT_PATH=D:\keys\your-project-firebase-adminsdk.json

# Or: save the downloaded key as "firebase-service-account.json" in this backend folder (no .env needed).

# USE_FIREBASE=false
