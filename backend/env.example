# Copy to backend/.env (do not commit .env)

# Required Firebase project for the whole repo (must match Flutter app):
#   safe-hair-274
# Console: https://console.firebase.google.com/project/safe-hair-274

# Recommended: download Admin SDK JSON from that project and save as:
#   backend/firebase-service-account-safe-hair-274.json
#
# Or set full path:
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service-account-safe-hair-274.json

# Optional: force API-only mode without Firestore
# USE_FIREBASE=false
